class cntup implements Runnable {
    public void run() {
        for (int i = 0; i < 5; i++) {
            System.out.println("T1: " + i);
        }
    }
}

class cntdn implements Runnable {
    public void run() {
        for (int i = 10; i > 1; i--) {
            System.out.println("T2: " + i);
        }
    }
}

public class ThreadDemo {
    public static void main(String[] args) {
        Runnable r1 = new cntup();
        Runnable r2 = new cntdn();

        Thread t1 = new Thread(r1);  
        Thread t2 = new Thread(r2);

        t1.start(); 
        t2.start();  
    }
}
