import java.util.*;
public class smr 
{
 public static void main(String[] args) 
 {
  Scanner sc = new Scanner(System.in);
  int n = 0;
  boolean valid = false;
  while (!valid) 
  {
   try 
   {
    System.out.print("Enter number of students whose marks you want to store: ");
    n = sc.nextInt();
    sc.nextLine();
    if (n < 0) throw new NegativeArraySizeException("Number of students cannot be negative.");
    valid = true;
   }
    catch (InputMismatchException e) 
    {
     System.out.println("Invalid input! Please enter an integer.");
     sc.nextLine();
     }
      catch (NegativeArraySizeException e) 
      {
       System.out.println(e.getMessage());
       }
        catch (Exception e) 
        {
         System.out.println("Unexpected error: " + e.getMessage());
         }
  }
       String[] names = new String[n];
       double[] marks = new double[n];
       char[] grades = new char[n];
       for (int i = 0; i < n; i++) 
       {
	System.out.println("\nStudent " + (i + 1) + ":");
	String name = "";
	while (true) 
	{
         System.out.print("Enter name: ");
         name = sc.nextLine().trim();
         if (name.isEmpty()) 
	 {
          System.out.println("Name cannot be empty. Please enter a valid name.");
         }
          else 
 	  {
           break;
          }
	}
          names[i] = name;
	  System.out.print("Enter marks out of 100: ");
	  while (!sc.hasNextDouble()) 
 	  {
           System.out.println("Invalid input! Please enter a number.");
           sc.next();
    	  }
    	   marks[i] = sc.nextDouble();
    	   sc.nextLine();
	   if (marks[i] >= 90)
                grades[i] = 'A';
           else if (marks[i] >= 75)
                grades[i] = 'B';
           else if (marks[i] >= 50)
                grades[i] = 'C';
           else
                grades[i] = 'F';
       }
        try 
	{
         System.out.println("\n======== Student Marks Record ========");
         System.out.printf("%-20s %-10s %-5s\n", "Name", "Marks", "Grade");
         for (int i = 0; i < n; i++) 
	 {
          System.out.printf("%-20s %-10.2f %-5c\n", names[i], marks[i], grades[i]);
         }
        }
	 catch (Exception e) 
	 {
          System.out.println("Error while printing results: " + e.getMessage());
         }
 }
}
